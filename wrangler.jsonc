{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gateway-proxy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",

  // VPC Network binding — routes connect() calls through a Cloudflare Tunnel
  "vpc_networks": [
    {
      "binding": "VPC",
      "tunnel_id": "YOUR-TUNNEL-ID",
      "remote": true
    }
  ],

  // HTTP proxy address reachable behind the tunnel
  "vars": {
    "PROXY_HOST": "YOUR-PROXY-HOST",
    "PROXY_PORT": "YOUR-PROXY-PORT",
    "DEBUG": "false",
    // When "true": if the proxy is unreachable before the request body is consumed,
    // the request falls through to Gateway's normal egress instead of returning 502.
    "FAIL_OPEN": "false"
  },

  // PROXY_USERNAME and PROXY_PASSWORD are optional secrets.
  // If set, a Proxy-Authorization: Basic header is added to every request.
  // To add auth:    wrangler secret put PROXY_USERNAME && wrangler secret put PROXY_PASSWORD && wrangler deploy
  // To remove auth: wrangler secret delete PROXY_USERNAME && wrangler secret delete PROXY_PASSWORD && wrangler deploy

  "observability": {
    "enabled": true,
    "logs": {
      // Capture 100% of logs — lower this for high-traffic deployments
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
